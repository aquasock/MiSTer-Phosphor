set_global_assignment -name SYSTEMVERILOG_FILE rtl/audio/vorbis/vorbis_setup_ram.sv
set_global_assignment -name MIF_FILE rtl/audio/vorbis/vorbis_imdct_rotation.mif
set_global_assignment -name MIF_FILE rtl/audio/vorbis/vorbis_window.mif
set_global_assignment -name SYSTEMVERILOG_FILE rtl/audio/vorbis/vorbis_unsigned_divider.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/audio/vorbis/vorbis_audio_packet_header.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/audio/vorbis/vorbis_huffman_decoder.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/audio/vorbis/vorbis_huffman_prefix.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/audio/vorbis/vorbis_packet_bits.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/audio/vorbis/vorbis_floor1_unpack.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/audio/vorbis/vorbis_huffman_reader.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/audio/vorbis/vorbis_audio_floor_control.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/audio/vorbis/vorbis_floor_pipeline.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/audio/vorbis/vorbis_prefix_builder.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/audio/vorbis/vorbis_residue_scheduler.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/audio/vorbis/vorbis_codebook_vector.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/audio/vorbis/vorbis_residue_vector_task.sv
