set_global_assignment -name SYSTEMVERILOG_FILE rtl/audio/vorbis/vorbis_fft.sv
set_global_assignment -name HEX_FILE rtl/audio/vorbis/vorbis_fft_twiddle.hex
set_global_assignment -name SYSTEMVERILOG_FILE rtl/audio/vorbis/vorbis_imdct.sv
set_global_assignment -name HEX_FILE rtl/audio/vorbis/vorbis_imdct_rotation.hex
set_global_assignment -name SYSTEMVERILOG_FILE rtl/audio/vorbis/vorbis_window_overlap.sv
set_global_assignment -name HEX_FILE rtl/audio/vorbis/vorbis_window.hex
