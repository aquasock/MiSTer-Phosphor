set_global_assignment -name SYSTEMVERILOG_FILE MiSTer_MP3.sv

# Project-specific timing constraints (see the file's own header for what
# it does and why): loaded after sys/sys_top.sdc, whose own clock-group
# assignment it refines, and after the reused HDMI-native-audio framework
# files above, whose own accompanying constraints (never copied over from
# MiSTer-Phosphor's MediaPlayer.sdc until this point) it ports the relevant
# parts of.
set_global_assignment -name SDC_FILE MiSTer_MP3.sdc
